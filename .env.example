# ABA — optional environment variables
# Copy this file to .env (gitignored) and fill in what you need. The server
# reads aba/.env automatically; real environment variables always win.

# Port for the ABA web app (default 4317)
# ABA_PORT=4317

# ---------------------------------------------------------------------------
# GitHub account sign-in (optional) — the repo autocomplete in Settings uses
# your connected GitHub account. Create a GitHub App ("ACC Battle Arena") and
# register http://localhost:4317/api/github/callback as a redirect URI.
# ABA_GITHUB_CLIENT_ID=Iv23licG5JnDx0V14zDh
# ABA_GITHUB_CLIENT_SECRET=your_client_secret
# ABA_GITHUB_REDIRECT_URI=http://localhost:4317/api/github/callback

# ---------------------------------------------------------------------------
# Freebuff provider (optional) — a local OpenAI-compatible proxy that exposes
# Freebuff's free models (see freebuff/README.md). ABA never runs it on its
# own; either start it manually (node freebuff/start.cjs) or opt in below.
# ABA_FREEBUFF_TOKENS=token1,token2
# ABA_FREEBUFF_AUTOSTART=1
# ABA_FREEBUFF_PORT=8080
# ABA_FREEBUFF_UPSTREAM=https://codebuff.com
