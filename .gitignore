# Dependencies — lockfiles ARE committed (npm is the package manager).
node_modules/
ui/node_modules/

# Build output — the UI dist is built on publish (prepare) and never committed.
ui/dist/

# OS
.DS_Store

# Secrets — never commit .env (client secrets, Freebuff tokens). Copy
# .env.example to .env and fill in your values.
.env

# Runtime artifacts (per-machine, regenerated)
~/.aba-sandbox/
reports/
.acc-memory.md

# freebuff
freebuff
